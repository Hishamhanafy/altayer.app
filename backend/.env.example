# 3altayer.app Backend Environment Variables Example

# Server Port
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/3altayer_db?schema=public"

# Redis (Caching & Geo Dispatch)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Auth
JWT_SECRET=super_secret_jwt_key_3altayer_2026
JWT_EXPIRATION=30d

# Platform Business Rules (Egypt - EGP)
CURRENCY=EGP
DRIVER_COMMISSION_BIDDING=0.10
DRIVER_COMMISSION_INSTANT=0.15
DRIVER_DEBT_LIMIT=-150.00
MIN_DRIVER_WALLET_THRESHOLD=-150.00
BASE_FARE_ECONOMY=20.00
PER_KM_RATE_ECONOMY=4.50
PER_MINUTE_RATE_ECONOMY=0.75
