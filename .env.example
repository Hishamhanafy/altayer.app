# ==============================================================================
# 3altayer.app - Environment Variables
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=3altayer
JWT_SECRET=super_secret_jwt_key_change_in_production_3altayer_2026
JWT_EXPIRES_IN=7d

# Localization & Currency
DEFAULT_CURRENCY=EGP
DEFAULT_CURRENCY_SYMBOL_AR=ج.م
DEFAULT_CURRENCY_SYMBOL_EN=EGP
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en

# PostgreSQL + PostGIS Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/3altayer_db?schema=public"

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Business & Commission Defaults (in Egyptian Pounds EGP)
DEFAULT_INSTANT_COMMISSION_PERCENT=15
DEFAULT_BIDDING_COMMISSION_PERCENT=10
DRIVER_DEBT_LIMIT=150.00 # Max allowed debt in EGP

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_BYPASS_CODE=123456 # For development testing
